# Configure secrets in your hosting provider, never in client code or source control.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=https://your-approved-app.example
AUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
AUTH_ISSUER=https://your-identity-provider.example
AUTH_AUDIENCE=telco-api
OPENAI_API_KEY=
OPENAI_MODEL=
# Internal MTN adapter only; no public subscriber endpoint is enabled.
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=
# MTN must confirm market-specific countryCode, usageType and timestamp formats.

# Privacy service: keep on private loopback, use a dedicated least-privilege DB role.
# PostgreSQL database must have server/migrations/001_privacy_consent.sql applied.
ACCOUNT_DATABASE_URL=postgresql://telvyo_api:REPLACE_ME@127.0.0.1:5432/telvyo
# Generate 32+ random bytes (base64/hex). Changing this changes pseudonymous account keys.
ACCOUNT_HASH_KEY=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_SECRET
