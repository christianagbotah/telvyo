# Hosted Worker settings. Configure real values in Sites Settings, never source.
# Deployment owner allowlist; set to the owner account used for Sites sign-in.
ADMIN_OWNER_EMAIL=owner@example.com
MTN_AUTH_METHOD=oauth
MTN_ENVIRONMENT=unknown
MTN_PRODUCTS=usage,plans,profiles
# Mark every credential as secret. Match the method required by your product.
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=
MTN_API_KEY=
